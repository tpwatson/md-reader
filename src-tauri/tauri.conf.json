{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD Reader",
  "mainBinaryName": "md-reader",
  "version": "0.1.0",
  "identifier": "com.mdreader.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MD Reader",
        "width": 920,
        "height": 820,
        "minWidth": 520,
        "minHeight": 420,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#f4f1ea"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http: https: data: blob:; style-src 'self'; font-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Read Markdown files",
    "longDescription": "A small Markdown reader you can use as the default app for .md files.",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
